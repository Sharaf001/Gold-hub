{
  "name": "gold-shop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/gold-shop run dev",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm run typecheck && pnpm -r run build",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:seed": "pnpm --filter @workspace/db run seed"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
